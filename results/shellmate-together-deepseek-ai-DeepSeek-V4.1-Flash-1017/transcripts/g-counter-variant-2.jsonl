ext.Background(), peerTimeout)\n\t\t\t\tdefer cancel()\n\n\t\t\t\tvar r result\n\t\t\t\tif v, err := s.kv.ReadInt(ctx, keyPrefix+id); err == nil {\n\t\t\t\t\tr.kv = int64(v)\n\t\t\t\t}\n\t\t\t\tif v, err := s.peerTotal(ctx, id); err == nil {\n\t\t\t\t\tr.peer = v\n\t\t\t\t\tr.ok = true\n\t\t\t\t}\n\n\t\t\t\tmu.Lock()\n\t\t\t\tresults[id] = r\n\t\t\t\tmu.Unlock()\n\t\t\t}(id)\n\t\t}\n\t\twg.Wait()\n\n\t\tallOK := true\n\t\ts.mu.Lock()\n\t\tfor id, r := range results {\n\t\t\tv := r.kv\n\t\t\tif r.peer > v {\n\t\t\t\tv = r.peer\n\t\t\t}\n\t\t\tif v > s.known[id] {\n\t\t\t\ts.known[id] = v\n\t\t\t}\n\t\t\tif !r.ok {\n\t\t\t\tallOK = false\n\t\t\t}\n\t\t}\n\t\ttotal := s.local\n\t\tfor _, v := range s.known {\n\t\t\ttotal += v\n\t\t}\n\t\ts.mu.Unlock()\n\n\t\tif allOK || time.Now().After(deadline) {\n\t\t\treturn total\n\t\t}\n\t}\n}\n\n// peerTotal asks another node for its own tally.\nfunc (s *server) peerTotal(ctx context.Context, id string) (int64, error) {\n\trespCh := make(chan int64, 1)\n\terr := s.n.RPC(id, map[string]any{\"type\": \"peer_read\"}, func(msg maelstrom.Message) error {\n\t\tvar body struct {\n\t\t\tTotal int64 `json:\"total\"`\n\t\t}\n\t\tif err := json.Unmarshal(msg.Body, &body); err != nil {\n\t\t\treturn nil\n\t\t}\n\t\tselect {\n\t\tcase respCh <- body.Total:\n\t\tdefault:\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\n\tselect {\n\tcase <-ctx.Done():\n\t\treturn 0, ctx.Err()\n\tcase v := <-respCh:\n\t\treturn v, nil\n\t}\n}\n", "path": "/work/main.go"}, "arguments_error": null, "id": "call_01a2044112f572d2a2b2b9a6", "name": "write_file"}], "usage": {"input_tokens": 54898, "output_tokens": 8270}}}
