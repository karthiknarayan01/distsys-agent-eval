m/demo/ruby/echo.rb\n/opt/maelstrom/demo/ruby/echo_full.rb\n/opt/maelstrom/demo/ruby/errors.rb\n/opt/maelstrom/demo/ruby/g_set.rb\n/opt/maelstrom/demo/ruby/lin_kv_proxy.rb\n/opt/maelstrom/demo/ruby/node.rb\n/opt/maelstrom/demo/ruby/pn_counter.rb\n/opt/maelstrom/demo/ruby/promise.rb\n/opt/maelstrom/demo/ruby/raft.rb\n/opt/maelstrom/demo/rust/Cargo.lock\n/opt/maelstrom/demo/rust/Cargo.toml\n/opt/maelstrom/demo/rust/README.md\n/opt/maelstrom/doc/01-getting-ready/index.md\n/opt/maelstrom/doc/02-echo/index.md\n/opt/maelstrom/doc/03-broadcast/01-broadcast.md\n/opt/maelstrom/doc/03-broadcast/02-performance.md\n/opt/maelstrom/doc/03-broadcast/broadcast-storm.png\n/opt/maelstrom/doc/03-broadcast/grid.png\n/opt/maelstrom/doc/03-broadcast/index.md\n/opt/maelstrom/doc/03-broadcast/line.png\n/opt/maelstrom/doc/03-broadcast/no-comms.png\n/opt/maelstrom/doc/04-crdts/01-g-set.md\n/opt/maelstrom/doc/04-crdts/02-counters.md\n/opt/maelstrom/doc/04-crdts/index.md\n/opt/maelstrom/doc/04-crdts/latency-partitions.png\n/opt/maelstrom/doc/05-datomic/01-single-node.md\n/opt/maelstrom/doc/05-datomic/02-shared-state.md\n/opt/maelstrom/doc/05-datomic/03-persistent-trees.md\n/opt/maelstrom/doc/05-datomic/04-optimization.md\n/opt/maelstrom/doc/05-datomic/g-single-realtime.svg\n/opt/maelstrom/doc/05-datomic/g1-realtime.svg\n/opt/maelstrom/doc/05-datomic/index.md\n/opt/maelstrom/doc/05-datomic/interleaved-keys.png\n/opt/maelstrom/doc/05-datomic/linear-slowdown.png\n/opt/maelstrom/doc/05-datomic/lww-high-latency.png\n/opt/maelstrom/doc/05-datomic/missing-value.png\n/opt/maelstrom/doc/05-datomic/not-concurrent.png\n/opt/maelstrom/doc/05-datomic/thunk-latency.png\n/opt/maelstrom/doc/05-datomic/thunk-map.png\n/opt/maelstrom/doc/06-raft/01-key-value.md\n/opt/maelstrom/doc/06-raft/02-leader-election.md\n/opt/maelstrom/doc/06-raft/03-replication.md\n/opt/maelstrom/doc/06-raft/04-committing.md\n/opt/maelstrom/doc/06-raft/final.png\n/opt/maelstrom/doc/06-raft/index.md\n/opt/maelstrom/doc/06-raft/lots-of-fai