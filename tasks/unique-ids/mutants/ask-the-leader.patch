 		// numbers become float64 (53-bit mantissa); a 64-bit integer ID
 		// would lose bits. Strings survive intact.
+		// One node mints every ID, so IDs are unique by construction. The others ask it.
 		body["type"] = "generate_ok"
+		if leader := n.NodeIDs()[0]; n.ID() != leader {
